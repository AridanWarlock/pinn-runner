  "analysis_seconds": 107.82944033306558,
  "limitations": "No training, no CUDA acceptance/performance. Independent Cartesian space and time Gauss quadratures, eager physical PDE derivatives. Bounds are quadrature estimates, not certified continuous bounds; one frozen checkpoint only. Modal identities test consistency of observed error and history of residual; not a proof of absence of all implementation bugs.",
  "analysis_source": "import hashlib,json,sys,time\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()))\nimport numpy as np\nimport torch\nfrom benchmarks.cases import CASES\nfrom benchmarks.neumann_projection import project_neumann_error\nfrom scripts.benchmark_robin_execution import load_model\ntrial=Path('numerical-reports/actual-cuda-checkpoint')\noriginal=json.loads((trial/'result.json').read_text());case=CASES[original['case']]\ntorch.set_num_threads(1)\nfactory,model=load_model(trial,'eager',original.get('hard_lifting','recursive'),'cpu')\nmodel=model.double().requires_grad_(False)\nT=.5;d=case.dimensions;rate=4*.1*d*np.pi**2\nmeasurements=[]\nstarted=time.perf_counter()\nfor ns,nt in ((15,17),(19,25)):\n z,w=np.polynomial.legendre.leggauss(ns);nodes=tuple((z+1)/2 for _ in range(d));weights=tuple(w/2 for _ in range(d))\n tz,tw=np.polynomial.legendre.leggauss(nt);times=np.concatenate(([0.],T*(tz+1)/2,[T]));timeweights=T*tw/2\n mesh=np.meshgrid(*nodes,times,indexing='ij');features=[a.reshape(-1,1) for a in mesh]\n predictions=[];residuals=[]\n for start in range(0,len(features[0]),256):\n  columns=[torch.tensor(a[start:start+256],dtype=torch.float64,requires_grad=True) for a in features]\n  with torch.enable_grad():\n   output=dict(model(columns[:-1],columns[-1]));r=factory.adapter.residuals(output,*columns)['heat']\n  predictions.append(output['u'].detach().numpy());residuals.append(r.detach().numpy())\n values=np.concatenate(predictions).reshape(-1,len(times));residual=np.concatenate(residuals).reshape(values.shape)\n space_mesh=np.meshgrid(*nodes,indexing='ij');spatial={a:x.reshape(-1,1) for a,x in zip(factory.settings.domain.space,space_mesh)}\n error=values-case.reference(spatial,times.reshape(1,-1))\n ep=project_neumann_error(nodes,weights,((0.,1.),)*d,error,rate)\n rp=project_neumann_error(nodes,weights,((0.,1.),)*d,residual,rate)\n kernel=np.exp(-ep.rates[:,None]*(T-times[None,1:-1]))\n predicted=np.exp(-ep.rates*T)*ep.coefficients[:,0]+np.sum(kernel*rp.coefficients[:,1:-1]*timeweights,axis=1)\n actual=ep.coefficients[:,-1]\n rows=[dict(index=list(idx),decay_rate=float(decay),observed_final_error=float(a),integrated_residual_error=float(b),identity_defect=float(a-b)) for idx,decay,a,b in zip(ep.indices,ep.rates,actual,predicted)]\n mean_bound=abs(ep.coefficients[0,0])+float(np.dot(timeweights,np.abs(rp.coefficients[0,1:-1])))\n initial_perp=float(np.sqrt(max(0.,ep.total[0]-ep.groups['constant'][0])))\n residual_perp=np.sqrt(np.maximum(0.,rp.total[1:-1]-rp.groups['constant'][1:-1]))\n perp_bound=np.exp(-.1*np.pi**2*T)*initial_perp+float(np.dot(timeweights,np.exp(-.1*np.pi**2*(T-times[1:-1]))*residual_perp))\n full_bound=float(np.dot(timeweights,np.sqrt(rp.total[1:-1])))+float(np.sqrt(ep.total[0]))\n measurements.append(dict(space_points=ns,time_points=nt,total_evaluated_points=len(features[0]),final_error_l2=float(np.sqrt(ep.total[-1])),mean_bound=mean_bound,nonconstant_bound=perp_bound,combined_bound=float(np.hypot(mean_bound,perp_bound)),undamped_bound=full_bound,largest_coefficient_identity_defect=float(np.max(np.abs(actual-predicted))),modes=rows,time_nodes=times.tolist(),time_weights=timeweights.tolist(),modal_error=ep.coefficients.tolist(),modal_residual=rp.coefficients.tolist()))\n print('COMPLETED',ns,nt,measurements[-1]['largest_coefficient_identity_defect'],flush=True)\nreport=dict(maximum_decay_rate=rate,contract=1,case=case.name,seed=original['seed'],device='cpu',precision='float64 evaluation of fixed float32-trained weights',torch=torch.__version__,cpu_threads=1,checkpoint_sha256=hashlib.sha256((trial/'training/checkpoints/final.ckpt').read_bytes()).hexdigest(),measurements=measurements,analysis_seconds=time.perf_counter()-started,limitations='No training, no CUDA acceptance/performance. Independent Cartesian space and time Gauss quadratures, eager physical PDE derivatives. Bounds are quadrature estimates, not certified continuous bounds; one frozen checkpoint only. Modal identities test consistency of observed error and history of residual; not a proof of absence of all implementation bugs.')\nreport['analysis_source']=Path(__file__).read_text()\nPath('docs/experiments/2026-10-16-duhamel-high-modes-cpu.json').write_text(json.dumps(report,indent=2,allow_nan=False))\nprint(json.dumps({k:v for k,v in report.items() if k!='analysis_source'},indent=2))\n",
